:root {
  --red: #d52b1e;
  --green: #009b48;
  --bg: #f7f4ee;
  --card: #ffffff;
  --text: #222;
  --muted: #666;
  --ok: #2e9e4f;
  --ko: #d6392d;
}

* { box-sizing: border-box; }

body {
  margin: 0;
  font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  background: var(--bg);
  color: var(--text);
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

header {
  background: linear-gradient(135deg, var(--red), #a81f15);
  color: #fff;
  padding: 1rem 1.2rem;
  border-bottom: 6px solid var(--green);
}
header h1 { margin: 0; font-size: 1.5rem; }
header .sub { display: block; font-size: .85rem; font-weight: 400; opacity: .9; }
.best { margin-top: .4rem; font-size: .85rem; opacity: .95; }

main { flex: 1; width: 100%; max-width: 720px; margin: 0 auto; padding: 1rem; }
footer { text-align: center; color: var(--muted); font-size: .8rem; padding: 1rem; }

.screen { display: none; }
.screen.active { display: block; }

h2 { font-size: 1.05rem; margin: 1.2rem 0 .6rem; }

.chips { display: flex; flex-wrap: wrap; gap: .5rem; }
.chip {
  border: 2px solid #ddd; background: var(--card); border-radius: 999px;
  padding: .45rem .9rem; font-size: .95rem; cursor: pointer;
}
.chip.selected { border-color: var(--green); background: #e6f6ec; font-weight: 600; }

.modes { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: .8rem; }
.mode {
  display: flex; flex-direction: column; align-items: center; gap: .25rem;
  background: var(--card); border: 2px solid var(--red); border-radius: 14px;
  padding: 1rem; font-size: 2rem; cursor: pointer; transition: transform .1s;
}
.mode strong { font-size: 1.1rem; }
.mode small { font-size: .8rem; color: var(--muted); text-align: center; }
.mode:hover { transform: translateY(-2px); background: #fff5f4; }
.mode.small { font-size: 1rem; padding: .6rem 1.2rem; }

.bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
.bar h2 { margin: 0; }
.back { border: none; background: none; color: var(--red); font-size: 1rem; cursor: pointer; padding: .3rem 0; }
.stats { display: flex; gap: 1rem; font-weight: 600; }

.card { background: var(--card); border-radius: 16px; box-shadow: 0 2px 8px rgba(0,0,0,.08); padding: 1.5rem; }
.question { text-align: center; margin: 1rem 0; position: relative; }
.label { color: var(--muted); font-size: .85rem; text-transform: uppercase; letter-spacing: .05em; }
.word { font-size: 2.4rem; font-weight: 700; margin-top: .4rem; word-break: break-word; }
.speak { position: absolute; top: .6rem; right: .6rem; border: none; background: none; font-size: 1.4rem; cursor: pointer; }

.options { display: grid; grid-template-columns: 1fr 1fr; gap: .7rem; }
.option {
  background: var(--card); border: 2px solid #ddd; border-radius: 12px;
  padding: 1rem; font-size: 1.05rem; cursor: pointer;
}
.option:hover:not(:disabled) { border-color: var(--green); }
.option.correct { background: #e1f5e7; border-color: var(--ok); }
.option.wrong { background: #fde6e3; border-color: var(--ko); }
.feedback { min-height: 1.6rem; margin-top: .8rem; text-align: center; font-weight: 600; }

.grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: .6rem; margin-top: 1rem; }
.tile {
  aspect-ratio: 1 / 1; border: none; border-radius: 12px; font-size: .95rem; font-weight: 600;
  background: var(--green); color: #fff; cursor: pointer; padding: .3rem;
  display: flex; align-items: center; justify-content: center; text-align: center; word-break: break-word;
}
.tile.open { background: #fff; color: var(--text); border: 2px solid var(--green); }
.tile.open.eu { border-color: var(--red); }
.tile.done { background: #e1f5e7; color: var(--ok); border: 2px solid var(--ok); cursor: default; }

.learn-list { list-style: none; padding: 0; margin: 1rem 0; display: grid; gap: .5rem; }
.learn-list li {
  display: flex; justify-content: space-between; align-items: center; gap: 1rem;
  background: var(--card); border-radius: 10px; padding: .7rem 1rem;
}
.learn-list .eu { font-weight: 700; color: var(--red); }
.learn-list button { border: none; background: none; font-size: 1.1rem; cursor: pointer; }

.end { text-align: center; margin-top: 2rem; }
.end-buttons { display: flex; gap: .8rem; justify-content: center; margin-top: 1rem; }

@media (max-width: 480px) {
  .options { grid-template-columns: 1fr; }
  .word { font-size: 2rem; }
  .grid { grid-template-columns: repeat(3, 1fr); }
}
